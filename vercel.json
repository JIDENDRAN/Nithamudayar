{
  "buildCommand": "cd best/best-fe && npm install && npm run build",
  "outputDirectory": "best/best-fe/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/uploads/(.*)",
      "destination": "/api/uploads?filename=$1"
    },
    {
      "source": "/((?!api|uploads).*)",
      "destination": "/index.html"
    }
  ]
}
